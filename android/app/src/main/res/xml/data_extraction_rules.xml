<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer. Downloaded
     chapters are re-downloadable and large: keep them out of both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
