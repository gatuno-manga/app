  "gaps": [
    {
      "id": "figma-contrast",
      "summary": "Figma tokens fail WCAG AA 4.5:1 in places and AppTheme follows them as the source of truth: color/on-primary (#fdfdfd) on color/primary is 2.5:1 in Dark, True-dark and Slate, 2.4:1 in Dracula, 4.0:1 in Light; on color/danger 3.1-3.9:1 in Light, Dracula, Slate; color/text-secondary and color/text-muted are 2.5-4.4:1 on color/app-background in most themes. Needs a Figma decision; PRODUCT.md has no WCAG target yet."
    },
    {
      "id": "fallback-text-roles",
      "summary": "Material text roles Figma does not define (displayMedium, displaySmall, headlineLarge, titleMedium, titleSmall) keep Material default sizes but render in Inknut Antiqua through ThemeData.fontFamily; bodySmall and other roles use onSurface, not color/text-secondary or color/text-muted. The mapped roles also change Material default sizes globally (bodyLarge 16->18, bodyMedium 14->16, bodySmall 12->14, labelMedium 12->13, labelSmall 11->12) with 150-160% line heights, so ListTile, TextField, dialog and chip text grow; check fixed-height rows at large text scales."
    },
    {
      "id": "themes-missing",
      "summary": "AppTheme has True-dark, Dracula and Slate builders, but no theme-selection mechanism exists in code (issue #51)."
    },
    {
      "id": "tokens-without-code",
      "summary": "radius/*, space/*, Vidro effects and reader themes have no ThemeData/ThemeExtension counterpart."
    },
    {
      "id": "badge-colors-not-in-figma",
      "summary": "GatunoColors badge colors (badgeDefault, badgeSearch, badgeType, badgeExcluded, badgeSensitive, badgePublication, badgeAuthor) and AppColors.gray*/badge* constants have no Figma variable; the Figma Tag/Filtro components should be inspected before mapping."
    },
    {
      "id": "degrader-not-in-figma",
      "summary": "GatunoColors.degrader gradient has no Figma style."
    },
    {
      "id": "figma-surfaces-empty",
      "summary": "Figma mobile sections 3 (Library/Profile), 4 (Auth) and 5 (Settings) have frames since issue #52 (Dark theme only, key states). Still without frames: web sections 3 (Auth) and 4 (Settings), web /library and /users/:userId, and the code-only welcome and certificates screens."
    },
    {
      "id": "routes-differ",
      "summary": "Figma routes /library, /users/:userId and /latest-reads have no matching code routes; Figma /auth/login, /auth/register, /user and /users/:userId map to code /auth/signin, /auth/signup, /settings and /settings/profile under different names. Code-only routes without Figma frames: /settings/certificates, /chapters/:id, /chapters/:id/page/:index, /requests, /requests/create and /welcome."
    },
    {
      "id": "cheap-weekly-exploration",
      "summary": "Collection 'Gatuno / The Cheap Weekly' (press-black palette) is a redesign exploration and is excluded from tokens."
    }
  ]
}
